              ".validate": "newData.isString() && newData.val().matches(/^(|lobby|stage_intro|voting|countdown|tallying|reveal|ranking|final)$/)"
            },
            "rankings": {
              ".validate": "newData.hasChildren()",
              "$index": {
                ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.hasChildren(['profileId', 'name', 'rank', 'score'])",
                "profileId": {
                  ".validate": "newData.isString() && newData.val().matches(/^p_[a-z0-9]+$/)"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
                },
                "rank": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
                },
                "score": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "stageResults": {
              ".validate": "newData.hasChildren()",
