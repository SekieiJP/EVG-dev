                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "label": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "min": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "max": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "from": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "to": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "lower": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "upper": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "$other": {
                        ".validate": false
                      }
                    }
                  },
                  "choices": {
                    "$optionIndex": {
                      "value": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "label": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "min": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "max": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "from": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "to": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "lower": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "upper": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "$other": {
                        ".validate": false
                      }
                    }
