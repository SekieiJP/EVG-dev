                  "ranges": {
                    "$optionIndex": {
                      "value": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "label": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "min": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "max": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "from": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "to": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "lower": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "upper": {
                        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
                      },
                      "$other": {
                        ".validate": false
                      }
                    }
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "publicPlayers": {
          ".read": "auth != null",
          ".write": false,
          "$profileId": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('roles').child('hosts').child(auth.uid).val() === true || newData.parent().parent().child('publicProfileOwners').child($profileId).val() === auth.uid)",
            ".validate": "newData.hasChildren(['profileId', 'name', 'connected', 'order']) && newData.child('profileId').val() === $profileId && $profileId.matches(/^p_[a-z0-9]+$/)",
            "profileId": {
              ".validate": "newData.isString() && newData.val() === $profileId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
