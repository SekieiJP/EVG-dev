            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && newData.val() % 1 === 0"
          },
          "volume": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
